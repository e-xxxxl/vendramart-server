# Server environment. Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (include the database name, e.g. /vendramart)
MONGODB_URI=

# The website's address (scheme and host, no path). Used for CORS, links in emails and Paystack's return page.
# Several can be listed with commas: https://yourdomain.com,https://www.yourdomain.com (the first is the main one).
CLIENT_ORIGIN=http://localhost:3000

# JWT: use a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=
JWT_EXPIRES_IN_DAYS=7

# Development only: where a browser reaches this API, for locally stored uploads. Default http://localhost:PORT
API_PUBLIC_URL=

# Used only by `npm run seed:admin` and `npm run seed` (dev values, change them)
SEED_ADMIN_EMAIL=admin@vendramart.test
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=VendraMart Admin
# Used by `npm run seed` and `npm run seed:demo` (demo stores with photos, a handler, a customer, past orders). Pick a password you can share.
SEED_DEMO_PASSWORD=

# Optional services. Leave blank to use the development fallbacks (see README, Settings).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_MAPS_SERVER_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Temporary Unsplash stand-in photos where a product or category has no image. Set to false to turn them off.
PLACEHOLDER_IMAGES=true
# Email through Resend (https://resend.com): create an API key, add and verify your domain, then set both lines below.
# EMAIL_FROM must be an address on the verified domain, for example VendraMart <orders@yourdomain.com>.
# When RESEND_API_KEY is set it is used instead of SMTP. With neither, emails are only printed in the server log.
RESEND_API_KEY=
# Or a normal mail server (used only when RESEND_API_KEY is empty):
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=VendraMart <no-reply@vendramart.test>
